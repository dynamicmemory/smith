const std::string model = "qwen3.5:9b";
const std::string embed_model = "nomic-embed-text";

void run_confirmation_loop();


int main(void) {
    curl_global_init(CURL_GLOBAL_DEFAULT);

    LlmClient client(model);
    ListFilesTool ls;
    ReadFileTool rd;
    CreateFileTool cf;
    DeleteFileTool df;
    WebSearchTool search;

    CreateTasksTool tt;
    ReflectionTool rf;

    ContextOptimizer optimizer(client);
    JsonMemoryStore memory_store("memories.json");
    MemoryManager memory_manager(memory_store, client);

    BeforeLlmCallback memory_callback = make_memory_injection_callback(memory_manager);
    AfterRunCallback memory_extraction_callback = [&memory_manager](ExecutionContext &context) {
        memory_manager.extract_memories(context.events());
    };

    BeforeLlmCallback optimizer_callback = 
        [&optimizer](ExecutionContext &context, LlmRequest &request) {
            return optimizer(context, request);
        };

    Agent agent(client, 
                {&ls, &rd, &cf, &df, &search, &tt, &rf}, 
                "You are a helpful assistant. For complex questions requiring multiple "
                "steps or research, create a task plan before performing any work. "
                "Update the plan as tasks are completed. Do not create plans for simple questions.",
                100,
                "agent",
                std::nullopt,
                {},
                {search_compressor_callback},
                {memory_callback, optimizer_callback},
                {memory_extraction_callback}
            );

    AgentResult result = agent.run("USE PLANNING TOOLS FOR THE QUESTION: If Eliud Kipchoge could maintain his marathon pace "
                                   "indefinitely, how many thousand hours would it take him to reach the moon?");

    for (const auto &event : result.context.events()) {
        std::cout << "\n=== EVENT: " << event.author << " ===\n";

        for (const auto &item : event.content) {
            std::visit([](const auto &value) {
                    using T = std::decay_t<decltype(value)>;

                    if constexpr (std::is_same_v<T, Message>) {
                    std::cout << "[" << value.role << "] "
                    << value.content << '\n';
                    }
                    else if constexpr (std::is_same_v<T, ToolCall>) {
                    std::cout << "[TOOL CALL] " << value.name << '\n'
                    << value.arguments.dump(4) << '\n';
                    }
                    else if constexpr (std::is_same_v<T, ToolResult>) {
                    std::cout << "[TOOL RESULT] " << value.name << '\n'
                    << "Status: "
                    << (value.status == ToolStatus::success ? "success" : "error")
                    << '\n';

                    for (const auto &content : value.content)
                    std::cout << content.dump(4) << '\n';
                    }
                    }, item);
        }

    }

    if (result.output.has_value()) {
        if (const auto *output = std::get_if<Json>(&*result.output))
            std::cout << output->dump(4) << '\n';
        else 
            std::cout << std::get<std::string>(*result.output) << '\n';
    }

    result = agent.run("What is the days date and the price of bitcoin?");
    for (const auto &event : result.context.events()) {
        std::cout << "\n=== EVENT: " << event.author << " ===\n";

        for (const auto &item : event.content) {
            std::visit([](const auto &value) {
                    using T = std::decay_t<decltype(value)>;

                    if constexpr (std::is_same_v<T, Message>) {
                    std::cout << "[" << value.role << "] "
                    << value.content << '\n';
                    }
                    else if constexpr (std::is_same_v<T, ToolCall>) {
                    std::cout << "[TOOL CALL] " << value.name << '\n'
                    << value.arguments.dump(4) << '\n';
                    }
                    else if constexpr (std::is_same_v<T, ToolResult>) {
                    std::cout << "[TOOL RESULT] " << value.name << '\n'
                    << "Status: "
                    << (value.status == ToolStatus::success ? "success" : "error")
                    << '\n';

                    for (const auto &content : value.content)
                    std::cout << content.dump(4) << '\n';
                    }
                    }, item);
        }

    }

    curl_global_cleanup();
    return 0;
}


void run_confirmation_loop() {
    LlmClient client(model);
    ListFilesTool ls;
    ReadFileTool rd;
    CreateFileTool cf;
    DeleteFileTool df;
    WebSearchTool search;

    ContextOptimizer optimizer(client);

    BeforeLlmCallback optimizer_callback = 
        [&optimizer](ExecutionContext &context, LlmRequest &request) {
            return optimizer(context, request);
        };

    Agent agent(client, 
            {&ls, &rd, &cf, &df, &search}, 
            "You are a helpful assistant",
            100,
            "agent",
            std::nullopt,
            {},
            {search_compressor_callback},
            {optimizer_callback}
            );

    AgentResult result = agent.run(
            "Find and delete the file named RandomFile.txt",
            "file_session"
            );

    while (result.status == AgentStatus::pending_confirmation) {
        std::vector<ToolConfirmation> confirmations;
        bool rejected = false;

        for (const auto &pending : result.pending_tool_calls) {
            std::cout << "\n" << pending.confirmation_message << '\n';
            std::cout << "Approve? (y/n): ";

            std::string answer;
            std::getline(std::cin, answer);

            bool approved = (answer == "y" || answer == "Y");

            if (!approved)
                rejected = true;

            confirmations.push_back({
                    pending.tool_call.tool_call_id,
                    approved ? std::nullopt
                    : std::optional<std::string>("Rejected by user."),
                    approved,
                    std::nullopt
                    });
        }

        result = agent.run("", "file_session", nullptr, confirmations);

        if (rejected) {
            std::cout << "\nTool execution rejected by user.\n";
            break;
        }
    }

    if (result.output.has_value()) {
        if (const auto *output = std::get_if<Json>(&*result.output))
            std::cout << output->dump(4) << '\n';
        else
            std::cout << std::get<std::string>(*result.output) << '\n';
    }
}
